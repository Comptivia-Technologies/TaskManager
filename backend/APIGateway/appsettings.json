{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EventBus": {
    "Provider": "AWS",
    "AWS": {
      "Region": "ap-south-1",
      "EventBusName": "work-flow-bus",
      "ServicePrefix": "task-manager",
      "VisibilityTimeoutSeconds": 300,
      "MaxReceiveCount": 3,
      "SchedulerGroupName": "task-manager-schedules",
      "SchedulerRoleArn": "arn:aws:iam::798277642170:role/workflow-automation-eventBridgeSchedulerRole"
    }
  },
  "TaskServiceApi": {
    "BaseUrl": "http://localhost:5005/api"
  },
  "WorkflowManagementApi": {
    "BaseUrl": "http://localhost:5000/api"
  },
  "ReverseProxy": {
    "Routes": {
      "workflow-route": {
        "ClusterId": "workflow-cluster",
        "Match": {
          "Path": "/api/workflows/{**catch-all}"
        }
      },
      "team-route": {
        "ClusterId": "workflow-cluster",
        "Match": {
          "Path": "/api/teams/{**catch-all}"
        }
      },
      "member-route": {
        "ClusterId": "workflow-cluster",
        "Match": {
          "Path": "/api/members/{**catch-all}"
        }
      },
      "stage-route": {
        "ClusterId": "workflow-cluster",
        "Match": {
          "Path": "/api/stages/{**catch-all}"
        }
      },
      "task-crud-base-route": {
        "ClusterId": "task-service-cluster",
        "Match": {
          "Path": "/api/tasks",
          "Methods": [ "GET" ]
        }
      },
      "task-crud-route": {
        "ClusterId": "task-service-cluster",
        "Match": {
          "Path": "/api/tasks/{**catch-all}",
          "Methods": [ "GET", "PUT", "DELETE" ]
        }
      },
      "sla-route": {
        "ClusterId": "sla-cluster",
        "Match": {
          "Path": "/api/sla-configurations/{**catch-all}"
        }
      },
      "priority-route": {
        "ClusterId": "priority-cluster",
        "Match": {
          "Path": "/api/priority-rules/{**catch-all}"
        }
      },
      "workload-route": {
        "ClusterId": "workload-cluster",
        "Match": {
          "Path": "/api/workload/{**catch-all}"
        }
      },
      "task-service-route": {
        "ClusterId": "task-service-cluster",
        "Match": {
          "Path": "/api/task-service/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "workflow-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5000"
          }
        }
      },
      "sla-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "priority-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5010"
          }
        }
      },
      "workload-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "task-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5005"
          }
        }
      }
    }
  }
}

